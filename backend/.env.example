# Copie para backend/.env e preencha.
ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg://instarix:instarix@localhost:5432/instarix
REDIS_URL=redis://localhost:6379/0

# Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=instarix
JWT_AUDIENCE=instarix-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Refresh token em cookie httpOnly para o navegador. Sem AUTH_COOKIE_SECURE,
# usa true em produção e false nos demais ambientes.
# AUTH_COOKIE_SECURE=false
# SameSite=none exige AUTH_COOKIE_SECURE=true (validado na inicialização).
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_NAME=instarix_refresh
AUTH_COOKIE_PATH=/v1/auth

# Confie em X-Forwarded-For apenas atrás de um proxy reverso controlado.
TRUST_PROXY_HEADERS=false

# Proxies de conta: sem valor, recusa hosts privados apenas em produção.
# PROXY_ALLOW_PRIVATE=true

# Uma ou mais chaves Fernet separadas por vírgula. A primeira criptografa;
# as demais continuam descriptografando dados antigos durante a rotação.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEYS=

REGISTRATION_ENABLED=true
# Origens exatas do frontend (com cookie de sessão o CORS usa credenciais;
# '*' é recusado). Ex.: CORS_ORIGINS=["https://app.exemplo.com"]
CORS_ORIGINS=[]

# Rate limiting por IP (janela deslizante) e lockout por conta.
# Use 0 em um limite para desativá-lo.
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_LIMIT=5
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REFRESH_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=300
AUTH_MAX_FAILED_LOGINS=5
AUTH_FAILED_LOGIN_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900

# Worker de jobs (a fila é a tabela jobs no Postgres; Redis não é usado).
JOB_WORKER_THREADS=2
# Sobe o worker dentro do Uvicorn; use apenas em desenvolvimento local.
EMBEDDED_WORKER_ENABLED=false
JOB_POLL_INTERVAL_SECONDS=2
JOB_LOCK_TIMEOUT_SECONDS=600
JOB_BACKOFF_BASE_SECONDS=5

# Diretório local dos arquivos baixados (relativo ao backend/).
MEDIA_STORAGE_DIR=media

# Uploads de mídia para publicação (bytes).
UPLOAD_MAX_BYTES=26214400

# Webhooks: timeout, tentativas e base do backoff.
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=10

# Rate limit por API key (0 desativa).
API_KEY_RATE_LIMIT=600
API_KEY_RATE_WINDOW_SECONDS=60

# Quotas por plano (0 = ilimitado).
QUOTA_FREE_ACCOUNTS=3
QUOTA_FREE_JOBS_PER_DAY=100
QUOTA_PRO_ACCOUNTS=25
QUOTA_PRO_JOBS_PER_DAY=5000

# RLS opt-in no PostgreSQL; requer scripts/enable_rls.py e worker com BYPASSRLS.
RLS_ENABLED=false
