# Copie para backend/.env e preencha.
ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg://instarix:instarix@localhost:5432/instarix
REDIS_URL=redis://localhost:6379/0

# Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=instarix
JWT_AUDIENCE=instarix-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Uma ou mais chaves Fernet separadas por vírgula. A primeira criptografa;
# as demais continuam descriptografando dados antigos durante a rotação.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEYS=

REGISTRATION_ENABLED=true
CORS_ORIGINS=[]

# Rate limiting por IP (janela deslizante) e lockout por conta.
# Use 0 em um limite para desativá-lo.
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_LIMIT=5
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REFRESH_LIMIT=30
AUTH_REFRESH_WINDOW_SECONDS=300
AUTH_MAX_FAILED_LOGINS=5
AUTH_FAILED_LOGIN_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900

# Worker de jobs (a fila é a tabela jobs no Postgres; Redis não é usado).
JOB_WORKER_THREADS=2
JOB_POLL_INTERVAL_SECONDS=2
JOB_LOCK_TIMEOUT_SECONDS=600
JOB_BACKOFF_BASE_SECONDS=5

# Diretório local dos arquivos baixados (relativo ao backend/).
MEDIA_STORAGE_DIR=media

# Uploads de mídia para publicação (bytes).
UPLOAD_MAX_BYTES=26214400

# Webhooks: timeout, tentativas e base do backoff.
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=10
